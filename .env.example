# ==== CONFIGURACIÓN DESARROLLO (SIN BASE DE DATOS) ====
PORT=3000
NODE_ENV=development

# Autenticación
JWT_SECRET=tu-secreto-super-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=2h

# (OPCIONAL) Base de datos - si no está seteada, usa JSON local
# DATABASE_URL=postgresql://user:pass@localhost:5432/growshop

# (OPCIONAL) Cloudinary para subida de imágenes
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Permitir registro de nuevos usuarios
ALLOW_REGISTER=1

# (OPCIONAL) Seed automático en inicio
# SEED_ON_START=1
